# Copia este archivo a .env y ajusta los valores antes de "docker compose up"
DATABASE_PASSWORD=stratton
BBDD_NAME=strattonapp
DB_PORT=3306
API_PORT=8080
WEB_PORT=80
# update conserva los datos entre arranques; create los borra
DDL_AUTO=update
SEED_DATA=true
SEED_RESET=false
# Clave para firmar los tokens JWT. Genera la tuya: openssl rand -base64 32
# Vacío = clave aleatoria en cada arranque (los usuarios tendrán que volver a iniciar sesión al reiniciar).
JWT_SECRET=
# true permite el auto-registro público en /register; false solo el ADMIN crea empleados
REGISTRO_ABIERTO=true
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200
LOG_LEVEL=INFO
